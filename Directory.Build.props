<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts</PackageOutputPath>
    <VersionPrefix>11.0.0</VersionPrefix>
	<VersionSuffix>rc2</VersionSuffix>
  </PropertyGroup>

  <!-- .NET 11 builds DirectWriteForwarder.dll and System.Printing.dll as mixed-mode
       assemblies (/clr:netcore). A single-file bundle loads them from memory and
       throws BadImageFormatException. Only the embedded WPF publish is a single
       file, and it opts into IncludeAllContentForSelfExtract so the host extracts
       those assemblies and ijwhost.dll to %TEMP%\.net and LoadLibrary can open them.
       Non-embedded WPF publishes as a normal multi-file app: wwwroot and the
       mixed-mode assemblies stay beside the exe, with no extraction directory.
       The tutorial sets PublishSingleFile in the project after importing this
       file, so the override is applied from a target. WinForms does not set
       UseWPF, so this target does not change it. -->
  <Target Name="ConfigureWpfPublishLayout"
          BeforeTargets="PrepareForPublish;_ComputeFilesToBundle">
    <PropertyGroup Condition="'$(UseWPF)' == 'true' and '$(Configuration)' != 'Embedded'">
      <PublishSingleFile>false</PublishSingleFile>
      <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
    </PropertyGroup>
    <PropertyGroup Condition="'$(UseWPF)' == 'true' and '$(Configuration)' == 'Embedded' and '$(PublishSingleFile)' == 'true'">
      <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
      <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    </PropertyGroup>
    <Message Importance="high" Condition="'$(UseWPF)' == 'true' and '$(Configuration)' != 'Embedded'" Text="WPF $(Configuration) publish is multi-file (PublishSingleFile=false)." />
    <Message Importance="high" Condition="'$(UseWPF)' == 'true' and '$(Configuration)' == 'Embedded' and '$(PublishSingleFile)' == 'true'" Text="Embedded WPF single-file publish extracts bundled files (including mixed-mode assemblies) on startup." />
  </Target>
</Project>
