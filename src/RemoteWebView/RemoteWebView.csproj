<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <DebugType Condition="'$(Configuration)' != 'Debug'">None</DebugType>
    <DebugSymbols Condition="'$(Configuration)' != 'Debug'">False</DebugSymbols>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Not a WPF project: drop the WebView2 package's WPF assembly (see Directory.Build.targets). -->
    <RemoveWebView2WpfReference>true</RemoveWebView2WpfReference>
    <RootNamespace>PeakSWC.RemoteWebView</RootNamespace>
    <UseWPF>false</UseWPF>
    <Platforms>x64;AnyCPU</Platforms>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>PeakSWC.RemoteWebView</PackageId>
    <Authors>Bud Cribar</Authors>
    <Description>Support Package for RemoteBlazorWebView.WindowsForms and RemoteBlazorWebView.Wpf</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>favicon-32x32.png</PackageIcon>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/budcribar/RemoteBlazorWebView</RepositoryUrl>
    <PackageTags></PackageTags>
    <AssemblyVersion>0.0.1.0</AssemblyVersion>
    <FileVersion>0.0.1.0</FileVersion>
    <Company>Peak Software Consulting, LLC</Company>
    <Copyright>Peak Software Consulting, LLC</Copyright>
    <AssemblyName>PeakSWC.RemoteWebView</AssemblyName>
    <Nullable>enable</Nullable>
    <Configurations>Debug;Release;Embedded;Developer</Configurations>
    <LangVersion>latest</LangVersion>
    <PackageProjectUrl>https://github.com/budcribar/RemoteBlazorWebView</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Based on maui 10.0.130. 10.0.15: sharing control between the owner and a remote user (give / take control, unattended sessions, session controls bar), voice calls, fixes for the trimmed and native relay. Upgrade the relay and the packages together. See RELEASE_NOTES.md in the repository.</PackageReleaseNotes>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Developer|x64'">
    <DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Properties\**" />
    <EmbeddedResource Remove="Properties\**" />
    <None Remove="Properties\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="blazor.modules.json" />
    <EmbeddedResource Include="_framework\blazor.modules.json" />
    <EmbeddedResource Include="..\RemoteWebView.Blazor.JS\dist\remote.blazor.desktop.js" Link="_framework/blazor.webview.js" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\Protos\webview.proto" GrpcServices="Client" Link="Protos\webview.proto" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Net.Client" Version="2.85.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView" Version="10.0.15" />
	
	  <PackageReference Include="Grpc.Tools" Version="2.85.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Abstractions" Version="10.0.15" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	  <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
	
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StaticContentCache.Tests" />
  </ItemGroup>

  <!-- The [RemoteBlazor] source generator ships in this package (so the Wpf and WindowsForms packages get it transitively), with a
       buildTransitive props file that makes the RemoteBlazorMode MSBuild property visible to it. Not referenced by this assembly. -->
  <ItemGroup>
    <ProjectReference Include="..\RemoteBlazorWebView.SourceGenerators\RemoteBlazorWebView.SourceGenerators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="..\RemoteBlazorWebView.SourceGenerators\bin\$(Configuration)\PeakSWC.RemoteBlazorWebView.SourceGenerators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="buildTransitive\PeakSWC.RemoteWebView.props" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\icons\favicon-32x32.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>


</Project>
