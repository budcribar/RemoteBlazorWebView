<Project Sdk="Microsoft.NET.Sdk">

  <!-- The [RemoteBlazor] source generator. It is packed into PeakSWC.RemoteWebView (analyzers/dotnet/cs), so every app that uses
       PeakSWC.RemoteBlazorWebView.Wpf or .WindowsForms gets it. See README.md in this folder. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>PeakSWC.RemoteBlazorWebView.SourceGenerators</AssemblyName>
    <RootNamespace>PeakSWC.RemoteBlazorWebView.SourceGenerators</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <Configurations>Debug;Release;Embedded;Developer</Configurations>
    <Platforms>x64;AnyCPU</Platforms>
    <!-- A fixed output folder (no platform, no TFM) so RemoteWebView.csproj can pack the dll from a known path. -->
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RemoteBlazorWebView.SourceGenerators.Tests" />
  </ItemGroup>

</Project>
