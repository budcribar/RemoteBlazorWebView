{
  "compilerOptions": {
    "moduleResolution": "node",
    "noImplicitAny": false,
    "noEmitOnError": true,
    "removeComments": false,
    "sourceMap": true,
    "target": "es2021",
    "module": "es2020",
    "lib": ["es2021", "dom"],
    "strict": true,
    "useDefineForClassFields": false,
    "skipLibCheck": true
  }
}
