<Project Sdk="Microsoft.NET.Sdk.Worker">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<Platforms>x64</Platforms>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<NoWarn>$(NoWarn);CA1416</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Grpc.Net.ClientFactory" Version="2.85.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="11.0.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
		
		<PackageReference Include="Grpc.Net.Client" Version="2.85.0" />
		<PackageReference Include="Google.Protobuf" Version="3.36.2" />
		<PackageReference Include="Grpc.Tools" Version="2.85.0">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="System.Management" Version="11.0.0" />
		
	</ItemGroup>

	<ItemGroup>
		<Protobuf Include="protos/filewatcher.proto" GrpcServices="Client" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Properties\PublishProfiles\" />
	</ItemGroup>
</Project>
