<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <LangVersion>latest</LangVersion>
	  <EnablePreviewFeatures>true</EnablePreviewFeatures>
	  <Platforms>x64</Platforms>
	  <NoWarn>$(NoWarn);CA1416</NoWarn>
	  <DefineConstants>DEBUG_SERVER;PROFILED_SERVER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Utilitiesx.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\test\FileSyncServer.Tests\Utilities.cs" Link="Utilities.cs" />
  </ItemGroup>
	<ItemGroup>
		<PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-rc.2.26504.105" />
		<PackageReference Include="Google.Protobuf" Version="3.36.2" />
		<PackageReference Include="Grpc.Net.Client" Version="2.84.0" />
		<PackageReference Include="Grpc.Net.Client.Web" Version="2.84.0" />
		<!--<PackageReference Include="PeakSWC.RemoteWebView" Version="10.0.0-preview3" />-->
		<PackageReference Include="System.Management" Version="11.0.0-rc.2.26504.105" />
		<ProjectReference Include="..\..\RemoteWebView\RemoteWebView.csproj" />
		<Protobuf Include="..\..\src\Protos\webview.proto" GrpcServices="Client" Link="Protos\webview.proto" />
	</ItemGroup>
	<PropertyGroup>
		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
		<GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
	</PropertyGroup>

</Project>
