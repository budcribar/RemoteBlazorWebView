<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<DebugType Condition="'$(Configuration)' != 'Debug'">None</DebugType>
		<DebugSymbols Condition="'$(Configuration)' != 'Debug'">False</DebugSymbols>
		<TargetFramework>net11.0-windows</TargetFramework>
		<!-- Not a WPF project: drop the WebView2 package's WPF assembly (see Directory.Build.targets). -->
		<RemoveWebView2WpfReference>true</RemoveWebView2WpfReference>
		<PackageId>PeakSWC.RemoteBlazorWebView</PackageId>
		<Authors>Bud Cribar</Authors>
		<Company>Peak Software Consulting, LLC</Company>
		<Description>.NET 11 package that hosts a remote Blazor UI on Windows, Mac, and Linux</Description>
		<GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
		<PackageDescription>.NET 11 package that hosts a remote Blazor UI on Windows, Mac, and Linux</PackageDescription>
		<Copyright>Peak Software Consulting, LLC</Copyright>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageIcon>favicon-32x32.png</PackageIcon>
		<RepositoryUrl>https://github.com/budcribar/RemoteBlazorWebView</RepositoryUrl>
		<PackageProjectUrl>https://github.com/budcribar/RemoteBlazorWebView</PackageProjectUrl>
		<PackageTags>BlazorWebView, Blazor, WebView, Photino</PackageTags>
		<Title>RemoteBlazorWebView</Title>
		<Nullable>enable</Nullable>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>Based on ASP.NET Core 11.0.0 and maui 11.0.10. 11.0.0, the first release for .NET 11: sharing control between the owner and a remote user (give / take control, unattended sessions, session controls bar), voice calls, fixes for the trimmed and native relay. Upgrade the relay and the packages together. See RELEASE_NOTES.md in the repository.</PackageReleaseNotes>
		<Configurations>Debug;Release;Embedded</Configurations>
		<Platforms>x64</Platforms>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Include="..\SharedSource\HostAddressHelper.cs" Link="HostAddressHelper.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Google.Protobuf" Version="3.36.2" />
		<PackageReference Include="Microsoft.AspNetCore.Components" Version="11.0.0" />
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="11.0.0" />
		<PackageReference Include="Microsoft.JSInterop" Version="11.0.0" />
		<PackageReference Include="Photino.Blazor" Version="4.0.13" />
		<PackageReference Include="Photino.Net" Version="4.0.16" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\RemoteWebView\RemoteWebView.csproj" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\..\..\RemoteBlazorWebViewTutorial\README.md">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
		<None Include="..\..\icons\favicon-32x32.png" Link="favicon-32x32.png">
			<PackagePath></PackagePath>
			<Pack>True</Pack>
		</None>
	</ItemGroup>



</Project>
