<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<DebugType Condition="'$(Configuration)' != 'Debug'">None</DebugType>
		<DebugSymbols Condition="'$(Configuration)' != 'Debug'">False</DebugSymbols>
		<TargetFramework>net9.0-windows</TargetFramework>
		<PackageId>PeakSWC.RemoteBlazorWebView</PackageId>
		<Authors>Bud Cribar</Authors>
		<Company>Peak Software Consulting, LLC</Company>
		<Description>.NET 9 package that hosts a remote Blazor UI on Windows, Mac, and Linux</Description>
		<GenerateNuspecDependsOn>$(GenerateNuspecDependsOn);SetPackageVersion</GenerateNuspecDependsOn>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageDescription>.NET 9 package that hosts a remote Blazor UI on Windows, Mac, and Linux</PackageDescription>
		<Copyright>Peak Software Consulting, LLC</Copyright>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageIcon>favicon-32x32.png</PackageIcon>
		<RepositoryUrl>https://github.com/budcribar/RemoteBlazorWebView</RepositoryUrl>
		<PackageProjectUrl>https://github.com/budcribar/RemoteBlazorWebView</PackageProjectUrl>
		<PackageTags>BlazorWebView, Blazor, WebView, Photino</PackageTags>
		<Title>RemoteBlazorWebView</Title>
		<Nullable>enable</Nullable>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>9.0.23 servicing release. Based on maui 9.0.120. Direct Microsoft .NET 9 servicing references are 9.0.23 (SDK 9.0.321). Microsoft.AspNetCore.Components.WebView.WindowsForms stays 9.0.120 and still brings Microsoft.AspNetCore.Components.WebView 9.0.9. .NET 9 end of support is November 10, 2026.</PackageReleaseNotes>
		<DebugType>full</DebugType>
		<Configurations>Debug;Release;Embedded</Configurations>
		<Platforms>x64</Platforms>
	</PropertyGroup>

	<Target Name="SetPackageVersion" DependsOnTargets="Build">
		<PropertyGroup>
			<PackageVersion>$(Version)</PackageVersion>
		</PropertyGroup>
	</Target>

	<ItemGroup>
	  <Compile Include="..\SharedSource\HostAddressHelper.cs" Link="HostAddressHelper.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Google.Protobuf" Version="3.36.2" />
		<PackageReference Include="Microsoft.AspNetCore.Components" Version="9.0.23" />
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.23" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.23" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.23" />
		<PackageReference Include="Microsoft.JSInterop" Version="9.0.23" />		<PackageReference Include="Photino.Blazor" Version="4.0.13" />
		<PackageReference Include="Photino.Net" Version="4.0.16" />

	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\RemoteWebView\RemoteWebView.csproj" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\..\..\RemoteBlazorWebViewTutorial\README.md">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
		<None Include="..\..\icons\favicon-32x32.png" Link="favicon-32x32.png">
			<PackagePath></PackagePath>
			<Pack>True</Pack>
		</None>
	</ItemGroup>



</Project>
