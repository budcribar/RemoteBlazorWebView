<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
	  <VersionPrefix>0.0.2</VersionPrefix>
    <TargetFramework>net9</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>PeakSWC.RemoteWebViewService.Lib</PackageId>
    <Authors>Bud Cribar</Authors>
    <Company>Peak Software Consulting, LLC</Company>
    <Description>Library for hosting the RemoteWebViewService.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/budcribar/RemoteBlazorWebView</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
	<IsPackable>true</IsPackable>
	<Copyright>Peak Software Consulting, LLC</Copyright>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
	<PackageIcon>favicon-32x32.png</PackageIcon>
	<RepositoryUrl>https://github.com/budcribar/RemoteBlazorWebView</RepositoryUrl>
	<PackageProjectUrl>https://github.com/budcribar/RemoteBlazorWebView</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
  
	  <None Include="..\..\icons\favicon-32x32.png" Link="favicon-32x32.png">
		  <PackagePath>
		  </PackagePath>
		  <Pack>True</Pack>
	  </None>
	  <EmbeddedResource Include="..\..\icons\favicon.ico" Link="Resources\favicon.ico">
		  <PackagePath>
		  </PackagePath>
		  <Pack>True</Pack>
	  </EmbeddedResource>
	  
	  
    <Protobuf Include="..\Protos\webview.proto" GrpcServices="Server" Link="Protos\webview.proto" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.14.0" />
    <PackageReference Include="Google.Protobuf" Version="3.31.1" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.71.0" />
    <PackageReference Include="Grpc.AspNetCore.Web" Version="2.71.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.6" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.6" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="9.0.6" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="9.0.6" NoWarn="NU1605" />
    <PackageReference Include="Microsoft.Graph.Beta" Version="5.86.0-preview" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Private.Uri" Version="4.3.2" />
    <PackageReference Include="Microsoft.Identity.Web" Version="3.9.3" />
    <PackageReference Include="Microsoft.Identity.Web.UI" Version="3.9.3" />
  </ItemGroup>
</Project>
