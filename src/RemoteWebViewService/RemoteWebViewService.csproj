<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
	<!--<DefineConstants>RATELIMIT</DefineConstants>-->
	  <!--<DefineConstants>STATS</DefineConstants>-->
	<ServerGarbageCollection>true</ServerGarbageCollection>
	<AssemblyVersion>$(VersionPrefix)</AssemblyVersion>
    <DisableImplicitNamespaceImports>true</DisableImplicitNamespaceImports>
    <DebugType Condition="'$(Configuration)' != 'Debug'">None</DebugType>
    <DebugSymbols Condition="'$(Configuration)' != 'Debug'">False</DebugSymbols>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <!--<TargetFramework>net8</TargetFramework>-->
	<TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <UserSecretsId>8957b802-74dd-4356-b829-9db91aa87089</UserSecretsId>
    <Nullable>enable</Nullable>
	
    <LangVersion>latest</LangVersion>
    <PackAsTool Condition="'$(Configuration)' == 'Release'">true</PackAsTool>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
    <PackageId>PeakSWC.RemoteWebViewService</PackageId>
    <ToolCommandName>RemoteWebViewService</ToolCommandName>
    <Authors>Bud Cribar</Authors>
    <Company>Peak Software Consulting, LLC</Company>
    <Description>This package will transport the user interface from an app built using RemoteBlazorWebView to a server running in the cloud. This allows an app running behind a firewall to be accessed through a browser via a cloud server.</Description>
    <Copyright>Peak Software Consulting, LLC</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>favicon-32x32.png</PackageIcon>
    <RepositoryUrl>https://github.com/budcribar/RemoteBlazorWebView</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>BlazorWebView, Blazor, WebView, RemoteBlazorWebView</PackageTags>
    <IsPackable>true</IsPackable>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <Configurations>Debug;Release;Authorization;NoAuthorization;AzureNoAuth</Configurations>

    <!-- Change to true when publishing locally -->
	<PublishAot Condition="'$(Configuration)' == 'NoAuthorization'">True</PublishAot>
	<PublishTrimmed Condition="'$(Configuration)' == 'NoAuthorization'">True</PublishTrimmed>
	<!--<RuntimeIdentifier Condition="'$(Configuration)' == 'NoAuthorization'">win-x64</RuntimeIdentifier>-->
	<PublishAot Condition="'$(Configuration)' == 'AzureNoAuth'">False</PublishAot>
	<PublishTrimmed Condition="'$(Configuration)' == 'AzureNoAuth'">False</PublishTrimmed>
	  <!--  <RuntimeIdentifier Condition="'$(Configuration)' == 'AzureNoAuth'">win-x64</RuntimeIdentifier>-->

	  <PublishSingleFile Condition="'$(Configuration)' == 'Authorization'">False</PublishSingleFile>
	<RuntimeIdentifier Condition="'$(Configuration)' == 'Authorization'">win-x64</RuntimeIdentifier>
	
    <DeleteExistingFiles>True</DeleteExistingFiles>
    <SelfContained>false</SelfContained>
    <!-- IL2104 / IL3053 / IL3000: trim and AOT warnings raised inside Microsoft's own assemblies (Components.WebAssembly.Server,
         Microsoft.CSharp, System.Linq.Expressions, the debug proxy launcher) during the native publish. Nothing in this repo can fix
         them; warnings from this repo's own code (IL2026, IL3050) are NOT suppressed. -->
    <NoWarn>NU5100;IL2104;IL3053;IL3000</NoWarn>
    <RootNamespace>PeakSWC.RemoteWebView</RootNamespace>
    <Platforms>x64</Platforms>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Based on maui 10.0.130. 10.0.15: sharing control between the owner and a remote user (give / take control, unattended sessions, session controls bar), voice calls, fixes for the trimmed and native relay. Upgrade the relay and the packages together. See RELEASE_NOTES.md in the repository.</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/budcribar/RemoteBlazorWebView</PackageProjectUrl>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='AzureNoAuth|x64'">
    <DefineConstants>$(DefineConstants);NOAUTHORIZATION</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='NoAuthorization|x64'" />
  
  <!-- All service code lives in RemoteWebViewService.Lib so it can also be hosted in-process; this exe is just Program.cs. -->
  <ItemGroup>
    <ProjectReference Include="..\RemoteWebViewService.Lib\RemoteWebViewService.Lib.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="appsettings.json.added" />
    <None Remove="appsettings.json.save" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="appsettings.json.save">
      <Pack>false</Pack>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
 
  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.85.0" />
    <PackageReference Include="Grpc.AspNetCore.Web" Version="2.85.0" />
	  
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.15" />
	<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.15" />
	<PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.15" NoWarn="NU1605" />
	  
    <PackageReference Include="Microsoft.Graph.Beta" Version="6.9.0-preview" />
    <PackageReference Condition="'$(Configuration)' != 'NoAuthorization'" Include="Newtonsoft.Json" Version="13.0.4" />
  
    <PackageReference Include="Microsoft.Identity.Web" Version="4.18.0" />
    <PackageReference Include="Microsoft.Identity.Web.UI" Version="4.18.0" />
  </ItemGroup>
  <ItemGroup>
	  <None Include="..\..\icons\favicon-32x32.png" Link="favicon-32x32.png">
		  <PackagePath>
		  </PackagePath>
		  <Pack>True</Pack>
	  </None>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>
      </PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Content Update="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
      <Pack>false</Pack>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
   
  </ItemGroup>

  <ProjectExtensions>
    <VisualStudio><UserProperties /></VisualStudio>
  </ProjectExtensions>
</Project>