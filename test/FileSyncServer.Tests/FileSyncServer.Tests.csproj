<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net11.0-windows10.0.17763.0</TargetFramework>
		<SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<Configurations>Debug;Release</Configurations>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<DefineConstants>xDEBUG_SERVER;xPROFILED_SERVER</DefineConstants>
		<Platforms>x64</Platforms>
		<!-- Same publish as RunTests.ps1. Output is gitignored; do not commit Client.exe. -->
		<FilePocClientProject>$(MSBuildThisFileDirectory)..\..\src\Benchmarks\FilePOC\Client\Client.csproj</FilePocClientProject>
		<FilePocClientPublishDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\src\Benchmarks\FilePOC\Client\publish'))\</FilePocClientPublishDir>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="BaseTestFixture.cs" />
	  <Compile Remove="Local\TestBlazorFormFixtureOld.cs" />
	  <Compile Remove="Local\TestLocalBlazorFormOld.cs" />
	</ItemGroup>

	<ItemGroup>
	  <Content Include="Local\BaseTestFixture.cs" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="TestResults\" />
		<Protobuf Include="..\..\..\Protos\webview.proto" GrpcServices="Client" Link="Protos\webview.proto" />
		<PackageReference Include="coverlet.collector" Version="10.1.0">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="FluentAssertions" Version="8.11.0" />
		<PackageReference Include="Google.Protobuf" Version="3.36.2" />
		<PackageReference Include="Grpc.Net.Client" Version="2.84.0" />
		<PackageReference Include="Grpc.Net.ClientFactory" Version="2.84.0" />
		<PackageReference Include="Grpc.Net.Client.Web" Version="2.84.0" />
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0-rc.2.26504.105" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0-rc.2.26504.105" />
		<PackageReference Include="System.Management" Version="11.0.0-rc.2.26504.105" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
		<PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
		<ProjectReference Include="..\..\src\RemoteBlazorWebView.Wpf\RemoteBlazorWebView.Wpf.csproj" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="Serilog.Extensions.Logging.File" Version="3.0.0" />
		<PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>

		<Using Include="Xunit" />
		<Using Include="FileSyncServer.Tests" />
		<None Include="$(FilePocClientPublishDir)Client.exe">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<Folder Include="Protos\" />
		<ProjectReference Include="..\..\src\RemoteWebView\RemoteWebView.csproj" />
		<ProjectReference Include="..\..\src\RemoteBlazorWebView.WinForms\RemoteBlazorWebView.WindowsForms.csproj" />
		<ProjectReference Include="..\..\src\RemoteBlazorWebView\RemoteBlazorWebView.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Content Update="wwwroot\css\app.css">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Update="wwwroot\css\site.css">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Update="wwwroot\favicon.ico">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Update="wwwroot\index.html">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

	<!-- Linux can compile this Windows desktop test project, but it cannot host Microsoft.WindowsDesktop.App.
	     Drop that framework from the test runtimeconfig so dotnet test can discover and skip the Windows-only tests. -->
	<UsingTask TaskName="RemoveWindowsDesktopFramework" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
		<ParameterGroup>
			<FilePath ParameterType="System.String" Required="true" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System.IO" />
			<Using Namespace="System.Text.RegularExpressions" />
			<Code Type="Fragment" Language="cs"><![CDATA[
				if (!File.Exists(FilePath))
					return true;
				var text = File.ReadAllText(FilePath);
				var updated = Regex.Replace(
					text,
					"\\s*\\{\\s*\"name\":\\s*\"Microsoft\\.WindowsDesktop\\.App\"[\\s\\S]*?\\},?",
					"",
					RegexOptions.Multiline);
				updated = Regex.Replace(updated, ",(\\s*])", "$1");
				if (!string.Equals(text, updated, StringComparison.Ordinal))
					File.WriteAllText(FilePath, updated);
				return true;
			]]></Code>
		</Task>
	</UsingTask>

	<Target Name="DropWindowsDesktopFrameworkForLinuxHost"
			AfterTargets="GenerateBuildRuntimeConfigurationFiles"
			Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
		<RemoveWindowsDesktopFramework FilePath="$(ProjectRuntimeConfigFilePath)" />
	</Target>

	<!-- Publish the win-x64 single-file client before the output copy. A clean tree has no Client.exe. -->
	<Target Name="PublishFilePocClient"
			BeforeTargets="GetCopyToOutputDirectoryItems"
			Inputs="$(FilePocClientProject);$(MSBuildThisFileDirectory)..\..\src\RemoteWebView\ClientFileSyncManager.cs;$(MSBuildThisFileDirectory)..\..\src\RemoteWebView\EtagGenerator.cs;$(MSBuildThisFileDirectory)..\..\src\RemoteWebView\StaticContentCacheControl.cs;$(MSBuildThisFileDirectory)..\..\src\SharedSource\HostAddressHelper.cs;$(MSBuildThisFileDirectory)..\..\src\Protos\webview.proto"
			Outputs="$(FilePocClientPublishDir)Client.exe">
		<MSBuild Projects="$(FilePocClientProject)"
				 Targets="Restore;Publish"
				 Properties="Configuration=Release;RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=true;PublishDir=$(FilePocClientPublishDir);EnableWindowsTargeting=true;Platform=x64;GeneratePackageOnBuild=false" />
	</Target>

</Project>
